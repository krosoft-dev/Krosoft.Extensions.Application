<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageTags>Krosoft Extension Application Cache Distributed Redis</PackageTags>
		<Description>Package pour faciliter la mise en place de la couche application avec du cache.</Description>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MediatR" Version="12.5.0" />
		<PackageReference Include="Krosoft.Extensions.Cache.Distributed.Redis" Version="2026.11.16.13631" />
		<PackageReference Include="Krosoft.Extensions.Cqrs" Version="2026.11.16.13641" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Krosoft.Extensions.Hosting" Version="2026.11.16.13644" />
	</ItemGroup>
</Project>
